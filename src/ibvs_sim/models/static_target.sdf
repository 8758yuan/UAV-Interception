<?xml version="1.0"?>
<sdf version="1.9">
  <model name="ibvs_target">
    <!-- A balloon must not behave like an infinite-mass wall.  It floats in
         place before impact, then yields to the vehicle with a soft contact. -->
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>true</allow_auto_disable>
    <link name="target_link">
      <gravity>false</gravity>
      <inertial>
        <mass>0.02</mass>
        <!-- Solid-sphere approximation: I = 2/5 m r^2, r = 0.25 m. -->
        <inertia>
          <ixx>0.0005</ixx>
          <iyy>0.0005</iyy>
          <izz>0.0005</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <velocity_decay>
        <linear>0.15</linear>
        <angular>0.15</angular>
      </velocity_decay>
      <visual name="target_visual">
        <geometry>
          <sphere>
            <radius>0.25</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
        </material>
      </visual>
      <collision name="target_collision">
        <geometry>
          <sphere>
            <radius>0.25</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.05</mu>
              <mu2>0.05</mu2>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.05</restitution_coefficient>
            <threshold>0.0</threshold>
          </bounce>
          <contact>
            <ode>
              <soft_cfm>0.01</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>100.0</kp>
              <kd>1.0</kd>
              <max_vel>0.5</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <sensor name="target_contact" type="contact">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <contact>
          <collision>target_collision</collision>
        </contact>
      </sensor>
    </link>
  </model>
</sdf>
